    {"std_id": "GB/T 25069-2022", "std_chinesename": "信息安全技术 术语", "std_type": "国标", "std_status": "现行", "ex_state": 1, "release_date": "2022-07-11"},
    {"std_id": "GB/T 35273-2020", "std_chinesename": "信息安全技术 个人信息安全规范", "std_type": "国标", "std_status": "现行", "ex_state": 1, "release_date": "2020-03-06"},
    {"std_id": "GB/T 16472-2024", "std_chinesename": "乘客电梯、载货电梯和杂物电梯用随行电缆", "std_type": "国标", "std_status": "现行", "ex_state": 1, "release_date": "2024-12-31"},
    {"std_id": "GB/T 1.1-2020", "std_chinesename": "标准化工作导则 第1部分：标准化文件的结构和起草规则", "std_type": "国标", "std_status": "现行", "ex_state": 1, "release_date": "2020-03-31"}
  ],
  "terms": [
    {"std_id": "GB/T 25069-2022", "term": "信息安全", "definition": "保护、维持和恢复信息及其系统的保密性、完整性、可用性、可核查性、真实性、可靠性和抗抵赖性。"},
    {"std_id": "GB/T 25069-2022", "term": "个人信息", "definition": "以电子或者其他方式记录的与已识别或者可识别的自然人有关的各种信息，不包括匿名化处理后的信息。"},
    {"std_id": "GB/T 25069-2022", "term": "数据元", "definition": "用一组属性描述其定义、标识、表示和允许值的数据单元。"},
    {"std_id": "GB/T 25069-2022", "term": "访问控制", "definition": "一种保证处理活动的参与方只能访问其被授权访问的信息的手段。"},
    {"std_id": "GB/T 35273-2020", "term": "个人敏感信息", "definition": "一旦泄露、非法提供或滥用可能危害人身和财产安全，极易导致歧视性待遇等的个人信息。"},
    {"std_id": "GB/T 35273-2020", "term": "匿名化", "definition": "通过对个人信息的技术处理，使得个人信息主体无法被识别，且处理后的信息不能被复原的过程。"},
    {"std_id": "GB/T 22239-2019", "term": "安全保护能力", "definition": "能够抵御威胁、发现安全事件以及在遭到损害后能够恢复先前状态等的程度。"},
    {"std_id": "GB/T 22239-2019", "term": "网络安全", "definition": "防范对网络的攻击、侵入、干扰、破坏和非法使用，保障网络数据完整性、保密性、可用性的能力。"},
    {"std_id": "GB/T 1.1-2020", "term": "术语", "definition": "明确界定某一概念含义的表述，通常由术语名称及其定义组成。"},
    {"std_id": "GB/T 1.1-2020", "term": "定义", "definition": "对概念含义的完整、准确描述，用以阐明术语所指称的概念。"},
    {"std_id": "GB/T 16472-2024", "term": "随行电缆", "definition": "随电梯运行、连接轿厢与井道内电气设备，并承受运行中弯曲、扭转等机械应力的柔性电缆。"}
  ]
}
